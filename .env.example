# Copy this file to .env and fill it in. Never commit .env.

# MySQL/MariaDB connection string
# Hostinger format is usually: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://user:password@localhost:3306/earthsar

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin. Created on start only if there are no admins yet.
# Remove ADMIN_PASSWORD after your first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Upload limits in MB (optional)
REVIEW_PHOTO_MAX_MB=5
REVIEW_VIDEO_MAX_MB=50
ADMIN_UPLOAD_MAX_MB=100

# Set to production on the live site
NODE_ENV=development
PORT=3000
