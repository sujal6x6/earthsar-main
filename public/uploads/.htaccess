Options -Indexes -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
<FilesMatch "(?i)\.(?!jpe?g$|png$|webp$|gif$|heic$|heif$|avif$|mp4$|webm$|mov$|m4v$|3gp$)[^.]+$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
