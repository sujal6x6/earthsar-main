RewriteEngine On

# Block deployment files before any real-file or catch-all routing.
Options -Indexes
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(?:server|scripts|test|node_modules)(?:/|$) - [F,L,NC]
RewriteRule ^(?:setup\.php|package(?:-lock)?\.json|README\.md)$ - [F,L,NC]
RewriteRule ^(?:public/)?uploads/.*\.(?!jpe?g$|png$|webp$|gif$|heic$|heif$|avif$|mp4$|webm$|mov$|m4v$|3gp$)[^/]+$ - [F,L,NC]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# 1. Route API requests to PHP router
RewriteRule ^api(/.*)?$ api/router.php [L,QSA]

# 2. Dynamic SEO files
RewriteRule ^robots\.txt$ api/seo.php?type=robots [L,QSA]
RewriteRule ^sitemap\.xml$ api/seo.php?type=sitemap [L,QSA]

# 3. Admin panel
RewriteRule ^admin/?$ public/admin/index.html [L]

# 4. If request is a real file/dir at root, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. If file exists inside public/, serve it directly (styles.css, main.js, assets/, uploads/, etc.)
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

RewriteCond public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# 6. SPA / Homepage catch-all -> index.php (injects dynamic SEO meta tags)
RewriteRule ^ index.php [L]
