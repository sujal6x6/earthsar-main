# Copy this file to .env and fill it in. Never commit .env.
# This is for the PHP version running on Hostinger shared hosting.

# MySQL connection (Hostinger provides these in hPanel → Databases)
DATABASE_HOST=localhost
DATABASE_USER=your_db_username
DATABASE_PASS=your_db_password
DATABASE_NAME=your_db_name

# OR use a single connection string (the PHP backend supports both formats):
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE

# Long random string (32+ characters). Generate one with:
#   php -r "echo bin2hex(random_bytes(48)) . PHP_EOL;"
JWT_SECRET=

# First admin. Created on start only if there are no admins yet.
# Remove ADMIN_PASSWORD after your first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Upload limits in MB (optional)
REVIEW_PHOTO_MAX_MB=5
REVIEW_VIDEO_MAX_MB=50
ADMIN_UPLOAD_MAX_MB=100

# Set to production on the live site
APP_ENV=production

# Your live site URL (optional, used for SEO canonical URLs)
SITE_URL=https://earthsar.in
